    public int nivel(Nodo r, char dato, int nivel) {

        if (r == null) {
            return -1;
        }

        if (r.getDato() == dato) {
            return nivel;
        }
        if (r.getDato() > dato) {
            return nivel(r.getLI(), dato, nivel + 1);
        } else {
            return nivel(r.getLD(), dato, nivel + 1);
        }

    }

