   private Nodo AVL(Nodo r) {

    int R = ValidarRot(r);

    switch (R) {

        case 1: // rotacion derecha

            Nodo p1 = r.getLI();

            r.setLI(p1.getLD());
            p1.setLD(r);

            return p1;

        case 2: // rotacion izquierda

            Nodo p2 = r.getLD();

            r.setLD(p2.getLI());
            p2.setLI(r);

            return p2;

        case 3: // rotacion doble derecha

            Nodo p3 = r.getLI();
            Nodo q3 = p3.getLD();

            p3.setLD(q3.getLI());
            r.setLI(q3.getLD());

            q3.setLI(p3);
            q3.setLD(r);

            return q3;

        case 4: // rotacion doble izquierda

            Nodo p4 = r.getLD();
            Nodo q4 = p4.getLI();

            p4.setLI(q4.getLD());
            r.setLD(q4.getLI());

            q4.setLD(p4);
            q4.setLI(r);

            return q4;

        default:
            return r;
    }
}

    public int FatorBalance(Nodo r) {
        if (r == null) {
            return 0;
        }

        return altura(r.getLI()) - altura(r.getLD());
    }

    public int ValidarRot(Nodo r) {

        int fb = FatorBalance(r);

        if (fb >= -1 && fb <= 1) {
            return 0;
        }

        if (fb > 1 && FatorBalance(r.getLI()) >= 0) {
            return 1;
        }

        if (fb < -1 && FatorBalance(r.getLD()) <= 0) {
            return 2;
        }

        if (fb > 1 && FatorBalance(r.getLI()) < 0) {
            return 3;
        }

        if (fb < -1 && FatorBalance(r.getLD()) > 0) {
            return 4;
        }

        return 0;
    }

